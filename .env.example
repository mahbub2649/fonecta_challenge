# Copy to .env. Never commit the real file.
# Your team's Yext sandbox key. Without it, the demo writes to the local mock only.
YEXT_API_KEY=
# Optional: lets owners reply in their own words. Without it, the buttons still work.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: lets owners reply by voice. Without it, typing and buttons still work.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# YEXT_BASE_URL=https://sbx-api.yextapis.com

# Where the challenge package is, if it isn't at fonecta_data/FONECTA_CONNECT_SUGGESTS_2026
# CONNECT_DATA_DIR=

# To open owner links on a phone on the same network:
# CONNECT_HOST=0.0.0.0
# CONNECT_PUBLIC_URL=http://<your-laptop-ip>:8080
