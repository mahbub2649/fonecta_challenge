# Copy to lumi/config.env and fill in. lumi/config.env is git-ignored.
LUMI_USER=your_lumi_username
LUMI_PROJECT=project_465000000          # Your LUMI project (billing account), as in `lumi-allocations`
LUMI_HOST=lumi.csc.fi
LUMI_SSH_KEY=~/.ssh/id_ed25519          # The key you registered with MyAccessID

# Optional. Defaults shown.
# LUMI_WORK=/scratch/$LUMI_PROJECT/$LUMI_USER/fonecta        # Code, data, runs, results
# LUMI_ENV=/projappl/$LUMI_PROJECT/$LUMI_USER/fonecta-env    # Python environment
# DATA_LOCAL=../fonecta_data/FONECTA_CONNECT_SUGGESTS_2026   # The challenge package on this laptop
# LUMI_PARTITION=small        # CPU partition. The model has no GPU code, so GPU partitions would waste billing units
# LUMI_CPUS=16                # Cores per experiment
# LUMI_MEM=32G
# LUMI_TIME=01:30:00          # Per experiment
# LUMI_MAX_PARALLEL=24        # Experiments running at once
